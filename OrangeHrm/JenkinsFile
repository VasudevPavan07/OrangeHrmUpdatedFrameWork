pipeline{

agent any

environment {
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-21.0.12'
        PATH = "C:\\Program Files\\Java\\jdk-21.0.12\\bin;${env.PATH}"
    }

tools {
    maven 'MyMaven'
    jdk 'JDK21'
}


stages{

stage('Debug Java') {
    steps {
        bat 'echo JAVA_HOME=%JAVA_HOME%'
        bat 'where java'
        bat 'mvn -v'
    }
}





stage ('Checkout'){
       
       steps{
          
           checkout scm
      
}     

   
}

stage('Build'){
 steps { 
    dir('OrangeHrm'){
 bat 'mvn clean compile -DskipTests'
}
   }
}


stage('Test'){
  steps {
  dir('OrangeHrm'){
catchError(buildResult: 'UNSTABLE' ,stageResult: 'FAILURE') { bat 'mvn test'}
}


}

}

stage('Report'){
  steps {
   junit allowEmptyResults :true, testResults :'OrangeHrm/target/surefire-reports/*.xml'
archiveArtifacts artifacts :'OrangeHrm/target/**' , allowEmptyArchive :true}
}

}

}
post {
 always {
     echo 'Pipeline finished'
    
 }

success {
echo 'All tests passed'}

failure {
echo 'Pipeline failed. Check the console output.'}

unstable {
 echo 'Build ran, but some tests failed.' 
}



}






